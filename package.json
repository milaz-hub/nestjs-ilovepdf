{
  "name": "nestjs-ilovepdf",
  "version": "0.1.1",
  "description": "NestJS library for integrating the iLovePDF REST API",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node test/smoke.cjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "nestjs",
    "ilovepdf",
    "pdf",
    "rest-api",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milaz-hub/nestjs-ilovepdf.git"
  },
  "bugs": {
    "url": "https://github.com/milaz-hub/nestjs-ilovepdf/issues"
  },
  "homepage": "https://github.com/milaz-hub/nestjs-ilovepdf#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/testing": "^12.4.2",
    "@types/node": "^26.6.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  }
}
